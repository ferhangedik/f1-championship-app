# Example environment variables file.
# Copy this file to ".env" and adjust the values for your environment. --- Windows PowerShell:  Copy-Item .env.example .env

# PostgreSQL connection settings
# IMPORTANT: on Windows use 127.0.0.1 instead of 'localhost' (TCP binding issue)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hfg_f1db
DB_USER=postgres
DB_PASSWORD=

# Flask settings
SECRET_KEY=please-change-this-to-a-long-random-secret
FLASK_PORT=8080
FLASK_DEBUG=1